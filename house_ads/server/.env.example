PORT=3000
NODE_ENV=production

# PostgreSQL (variáveis separadas: a senha vai literal, sem URL-encode)
PGHOST=postgres-onetour
PGPORT=5432
PGDATABASE=onetour
PGUSER=
PGPASSWORD=
PGSSL=false
# Alternativa: DATABASE_URL=postgres://user:senha-urlencoded@host:5432/onetour

# PocketBase (valida o token do admin)
POCKETBASE_URL=https://onetour-pocketbase-estados.gtalg3.easypanel.host

# Origem do admin web app (CORS). Várias origens separadas por vírgula.
ADMIN_ORIGIN=https://onetour-frontend-onetour.gtalg3.easypanel.host

# Intervalo do recálculo de rankings (minutos)
RANKINGS_INTERVAL_MIN=10
