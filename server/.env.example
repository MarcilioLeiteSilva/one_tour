# ==============================================================================
# One Tour Ecosystem - Environment Configuration
# ==============================================================================

# Domínios e Host
DOMAIN_CMS=cms.onetour.app
DOMAIN_ADS=ads.onetour.app
DOMAIN_STORAGE=cdn.onetour.app

# PocketBase (CMS & Admin)
PB_PORT=8090
PB_ENCRYPTION_KEY=onetour_secret_pb_encryption_key_32chars_min!!

# PostgreSQL 16 + PostGIS
POSTGRES_DB=onetour_ads
POSTGRES_USER=onetour_admin
POSTGRES_PASSWORD=onetour_secure_postgres_pass_2026!
POSTGRES_PORT=5432

# MinIO / S3 Storage (Para Mapas PMTiles e Pacotes SQLite)
MINIO_ROOT_USER=onetour_s3_admin
MINIO_ROOT_PASSWORD=onetour_s3_super_secret_password_2026!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_MAPS=onetour-maps
MINIO_BUCKET_PACKS=onetour-packs
